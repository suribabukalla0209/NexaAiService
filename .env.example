# Copy to .env and replace every placeholder. Never commit .env.
NEXA_ENVIRONMENT=development
NEXA_DATABASE_PATH=./data/nexa_ai.db
# For PostgreSQL, set NEXA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Keep credentials in the deployment secret store; never commit them.
NEXA_BATCH_SIZE_LIMIT=25
NEXA_PROCESSING_LEASE_SECONDS=180
NEXA_RATE_LIMIT_REQUESTS=60
NEXA_RATE_LIMIT_WINDOW_SECONDS=60
NEXA_RETRY_MAX_ATTEMPTS=3
NEXA_RETRY_BASE_DELAY_SECONDS=5
NEXA_RETRY_MAX_DELAY_SECONDS=300
NEXA_MESSAGE_RETENTION_DAYS=90
NEXA_LLM_BASE_URL=https://api.groq.com/openai/v1
NEXA_LLM_MODEL=openai/gpt-oss-120b
NEXA_LLM_API_KEY=replace-with-real-groq-api-key
NEXA_LLM_TIMEOUT_SECONDS=30
# JSON mapping of high-entropy bearer token to a stable account/user identifier.
# Generate a distinct token per Android user; do not share one token across accounts.
NEXA_ACCESS_TOKENS_JSON={"replace-with-a-random-32-byte-token-value":"android-user-1"}
